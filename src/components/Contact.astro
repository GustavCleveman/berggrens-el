---
const contactItems = [
  {
    label: 'Telefon',
    value: '0739-77 10 70',
    href: 'tel:+46739771070',
  },
  {
    label: 'E-post',
    value: 'daniel@berggrens-el.se',
    href: 'mailto:daniel@berggrens-el.se',
  },
  {
    label: 'Område',
    value: 'Stockholm, utgångspunkt Vallentuna',
    href: null,
  },
];
---

<section class="section" id="kontakt">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow" style="justify-content:center">Hör av dig</p>
      <h2 class="section-title">Kontakta oss</h2>
      <p class="section-lede">
        Beskriv vad du behöver hjälp med så återkommer vi så snart som
        möjligt – vanligtvis samma dag.
      </p>
    </div>

    <div class="contact-layout">
      <form
        id="contact-form"
        class="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <!-- TODO: replace with a real key from https://web3forms.com (free) -->
        <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="subject" value="Nytt meddelande från berggrens-el.se" />

        <div class="field-row">
          <div class="field">
            <label for="name">Namn</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="phone">Telefon</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
        </div>
        <div class="field">
          <label for="email">E-post</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="message">Meddelande</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-gold">Skicka meddelande</button>
        <p class="form-status" id="form-status" role="status"></p>
      </form>

      <div class="contact-info">
        {
          contactItems.map((item) => (
            <div class="contact-item">
              <strong>{item.label}</strong>
              {item.href ? <a href={item.href}>{item.value}</a> : <span>{item.value}</span>}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const formData = new FormData(form);
    if (formData.get('botcheck')) return;

    status.textContent = 'Skickar...';
    status.className = 'form-status is-pending';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = 'Tack! Ditt meddelande är skickat, vi hör av oss snart.';
        status.className = 'form-status is-success';
        form.reset();
      } else {
        throw new Error(result.message || 'Något gick fel');
      }
    } catch {
      status.textContent =
        'Något gick fel. Ring oss gärna direkt på 0739-77 10 70 istället.';
      status.className = 'form-status is-error';
    }
  });
</script>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .contact-form {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 40px;
  }

  .botcheck {
    position: absolute;
    left: -9999px;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .field {
    margin-bottom: 18px;
  }

  .field label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .field input,
  .field textarea {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--paper);
    padding: 12px 14px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    border-radius: var(--radius);
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--gold);
  }

  .form-status {
    margin-top: 16px;
    font-size: 0.9rem;
    min-height: 1.4em;
  }

  .form-status.is-success {
    color: #4c7a4a;
  }

  .form-status.is-error {
    color: #b3453f;
  }

  .form-status.is-pending {
    color: var(--ink-soft);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-item {
    border: 1px solid var(--line);
    padding: 24px 28px;
    background: var(--paper-dim);
  }

  .contact-item strong {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gold-dark);
    margin-bottom: 8px;
  }

  .contact-item a,
  .contact-item span {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
  }

  .contact-item a:hover {
    color: var(--gold-dark);
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
