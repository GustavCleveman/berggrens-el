---
interface Props {
  name: 'home' | 'building' | 'wrench' | 'bolt' | 'bulb' | 'shield';
}

const { name } = Astro.props;

const paths: Record<Props['name'], string> = {
  home: 'M4 11.5L12 4l8 7.5 M6.5 9.8V20a1 1 0 001 1h3v-6h3v6h3a1 1 0 001-1V9.8',
  building:
    'M6 21V4a1 1 0 011-1h10a1 1 0 011 1v17 M9 21v-3.5h6V21 M9 7h1.5M13.5 7H15M9 11h1.5M13.5 11H15M9 15h1.5M13.5 15H15',
  wrench:
    'M14.5 3.4a4.6 4.6 0 00-5.5 6L3.4 15v4.6H8L13.6 14a4.6 4.6 0 006-5.5L16 12l-2.8-2.8 3.5-3.6z',
  bolt: 'M13 2 4 14h6l-1 8 9-12h-6l1-8z',
  bulb:
    'M9.2 18.2h5.6 M10.2 21h3.6 M12 3a6.2 6.2 0 00-3.7 11.2c.5.4.8 1 .8 1.7v.6h5.8v-.6c0-.7.3-1.3.8-1.7A6.2 6.2 0 0012 3z',
  shield: 'M12 3 19 6v5.2c0 5.1-3.4 8.5-7 9.8-3.6-1.3-7-4.7-7-9.8V6z',
};
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
