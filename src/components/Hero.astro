---
import { Image } from 'astro:assets';
import logo from '../assets/logo-transparent-light.png';
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Auktoriserad elinstallatör</p>
      <h1>Din lokala elinstallatör<br />du kan lita på</h1>
      <p class="hero-sub">
        Vi utför elarbeten för privatpersoner och företag i Stockholm, med
        utgångspunkt i Vallentuna – snabbt, säkert och till rätt pris.
      </p>
      <div class="hero-actions">
        <a href="#kontakt" class="btn btn-gold">Begär offert</a>
        <a href="#tjanster" class="btn btn-ghost">Se våra tjänster</a>
      </div>
    </div>
    <div class="hero-mark">
      <Image src={logo} alt="Berggrens El" width={340} height={340} />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--ink);
    color: var(--paper);
    padding: 72px 0 100px;
    position: relative;
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 82% 20%,
      rgba(171, 141, 87, 0.16),
      transparent 55%
    );
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 40px;
    position: relative;
    z-index: 1;
  }

  .hero-copy h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 18px 0 22px;
  }

  .hero-sub {
    font-size: 1.08rem;
    color: rgba(250, 248, 244, 0.72);
    max-width: 480px;
    margin-bottom: 40px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hero-mark {
    display: flex;
    justify-content: center;
    opacity: 0.92;
  }

  .hero-mark :global(img) {
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-sub {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-mark {
      order: -1;
    }

    .hero-mark :global(img) {
      max-width: 180px;
    }
  }
</style>
